{
  "name": "byterush",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/cache-assets.mjs && node scripts/verify-offline-shell.mjs",
    "start": "next start",
    "lint": "eslint",
    "cf:preview": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:package": "npm run build && bash scripts/package-artifact.sh",
    "d1:migrate": "wrangler d1 migrations apply DB --remote",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "test": "node scripts/validate-runs-source.mjs && node scripts/test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.6",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
